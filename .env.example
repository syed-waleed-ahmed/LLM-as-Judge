# Copy this file to `.env` and fill in your values. Never commit `.env`.

# Judge backend: groq (default), ollama, openai_compatible, or mock.
# "mock" is an offline heuristic (NOT an LLM) for demos and keyless use.
JUDGE_PROVIDER=groq

# Groq: free API key from https://console.groq.com/keys.
GROQ_API_KEY=your_groq_api_key_here

# Optional: which Groq-hosted model the judge uses.
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (local, free): start with `ollama serve`, then `ollama pull llama3.2`.
JUDGE_OLLAMA_BASE_URL=http://localhost:11434
JUDGE_OLLAMA_MODEL=llama3.2

# Any OpenAI-compatible endpoint (LM Studio, vLLM, llama.cpp server, ...).
# Prefixed on purpose: an unrelated OPENAI_API_KEY is never used.
# JUDGE_OPENAI_BASE_URL=http://localhost:1234/v1
# JUDGE_OPENAI_MODEL=local-model
# JUDGE_OPENAI_API_KEY=
# JUDGE_OPENAI_JSON_MODE=true

# Optional fallback: providers tried in order when a call to the primary fails.
# Off by default; every result answered by a fallback says so. "mock" is not allowed.
# JUDGE_FALLBACK_PROVIDERS=ollama

# Optional generation / request tuning.
JUDGE_TEMPERATURE=0.0
JUDGE_REQUEST_TIMEOUT=60
JUDGE_MAX_RETRIES=3

# Optional: repair retries when the judge returns malformed JSON or the wrong
# criteria (each retry tells the judge what was wrong).
JUDGE_MAX_PARSE_RETRIES=1

# Optional: run each comparison in both orders and average, to reduce the
# well-known position bias of LLM judges (doubles the number of API calls).
JUDGE_MITIGATE_POSITION_BIAS=false
# Run the two orderings concurrently (halves latency, same number of calls).
JUDGE_PARALLEL_BIAS_RUNS=true

# Optional scoring behaviour.
# Normalised (0-1) score gap treated as a tie; 0.06 is about half a point on 1-10.
JUDGE_TIE_MARGIN=0.06
# Flag wins by outputs at least this many times longer than the other.
JUDGE_VERBOSITY_RATIO=2.0
JUDGE_MAX_CRITERIA=20
# Round-robin ranking makes n(n-1)/2 comparisons; keep this modest on free tiers.
JUDGE_MAX_CANDIDATES=8
# Longer inputs are truncated and the result carries an "input_truncated" warning.
JUDGE_MAX_INPUT_CHARS=50000
# Longest optional judge guidance ("instructions"); longer text is truncated.
JUDGE_MAX_INSTRUCTIONS_CHARS=2000
# Opt-in in-memory cache of identical temperature-0 results (0 = off).
JUDGE_CACHE_SIZE=0

# Optional semantic similarity for reference grading (cosine of embeddings).
# JUDGE_EMBEDDINGS_PROVIDER=ollama          # or openai_compatible
# JUDGE_EMBEDDINGS_MODEL=nomic-embed-text
# JUDGE_EMBEDDINGS_BASE_URL=                 # defaults to the provider's base URL
# JUDGE_EMBEDDINGS_API_KEY=

# Optional: REST API (`llm-judge serve`). Leave keys unset only on localhost.
# JUDGE_API_KEYS=key-one,key-two
# JUDGE_API_ADMIN_KEY=
JUDGE_API_RATE_LIMIT=60
JUDGE_API_MAX_BODY_BYTES=1000000
JUDGE_API_MAX_CONCURRENT=4
JUDGE_API_MAX_BATCH_ROWS=50
JUDGE_API_MAX_JOB_ROWS=1000
JUDGE_API_MAX_QUEUED_JOBS=10
# JUDGE_API_CORS_ORIGINS=https://your-frontend.example

# Optional: public-demo safeguards for the Streamlit dashboard (see DEPLOYMENT.md).
JUDGE_DEMO_MODE=false
JUDGE_DEMO_SESSION_CALLS=25
JUDGE_DEMO_DAILY_CALLS=500
JUDGE_DEMO_MAX_INPUT_CHARS=4000
JUDGE_DEMO_MAX_ROWS=25
JUDGE_DEMO_MAX_CANDIDATES=5

# Optional: experiment-tracking database (SQLite file).
JUDGE_DB_PATH=.llm_judge/experiments.db

# Optional: dataset limits (files are rejected before parsing above these).
JUDGE_MAX_DATASET_BYTES=50000000
JUDGE_MAX_DATASET_ROWS=100000

# Optional: concurrency for `llm-judge batch`.
JUDGE_BATCH_MAX_WORKERS=4

# Optional: logging verbosity (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
