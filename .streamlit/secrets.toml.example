# Copy to .streamlit/secrets.toml (git-ignored), or paste into the Streamlit
# Community Cloud "Secrets" settings. The dashboard copies these into the
# environment at start-up.

GROQ_API_KEY = "your_groq_api_key_here"

# Public-demo safeguards: per-session and daily live-call budgets, input caps,
# and session-only storage.
JUDGE_DEMO_MODE = "true"
JUDGE_DEMO_SESSION_CALLS = "25"
JUDGE_DEMO_DAILY_CALLS = "500"
