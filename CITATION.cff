    family-names: Ahmed
version: 2.4.0
date-released: "2026-11-11"
license: MIT
repository-code: "https://github.com/syed-waleed-ahmed/LLM-as-Judge"
url: "https://syed-waleed-ahmed.github.io/LLM-as-Judge/"
keywords:
  - llm
  - llm-as-a-judge
  - evaluation
  - rag-evaluation
